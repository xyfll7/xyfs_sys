{
  "name": "@xyfs/main",
  "version": "2.3.11",
  "private": true,
  "description": "小象心选·团购真的省",
  "author": {
    "name": "xyfll7",
    "email": "l.7@qq.com",
    "url": "https://gitee.com/xyfll7/xyfs_sys"
  },
  "scripts": {
    "typecheck": "pnpm --filter @xyfs/* typecheck",
    "iit": "release-it",
    "update:project": "pnpm --filter @xyfs/taro_* --filter @xyfs/xyfs_* exec taro update project 4.0.12",
    "clean": "sudo rimraf --glob pnpm-lock.yaml ci___/node_modules common/**/node_modules common/**/dist* packages*/**/node_modules packages*/**/dist* packages*/**/build* packages*/**/.swc && rimraf node_modules",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/node": "^22.13.10",
    "commitizen": "^4.3.1",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "release-it": "^18.1.2",
    "rimraf": "^6.0.1",
    "zx": "^8.4.0"
  },
  "config": {
    "commitizen": {
      "path": "git-cz"
    }
  },
  "dependencies": {
    "node-xlsx": "^0.24.0"
  },
  "packageManager": "pnpm@10.9.0"
}
