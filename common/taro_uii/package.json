{
	"name": "@xyfs/taro_uii",
	"version": "2.3.13",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"description": "ui",
	"templateInfo": {
		"name": "default",
		"typescript": true,
		"css": "None",
		"framework": "React"
	},
	"exports": {
		"./*": {
			"import": "./src/*"
		}
	},
	"typesVersions": {
		">=5": {
			"*": [
				"./types/*"
			],
			"utils/*": [
				"src/utils/*"
			],
			"store/*": [
				"src/store/*"
			],
			"components/*": [
				"src/components/*"
			],
			"components_work/*": [
				"src/components_work/*"
			],
			"compages/*": [
				"src/compages/*"
			],
			"api/*": [
				"src/api/*"
			]
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "pnpm run build:lib && pnpm run build:types",
		"build:libx": "tsc && vite build",
		"build:lib": "vite build",
		"build:types": "tsc --rootDir ./src --declaration --emitDeclarationOnly --stripInternal --declarationDir dist/",
		"preview": "vite preview"
	},
	"browserslist": [
		"defaults and fully supports es6-module",
		"maintained node versions"
	],
	"author": "",
	"dependencies": {
		"@babel/runtime": "^7.24.4",
		"@tarojs/components": "4.0.12",
		"@tarojs/helper": "4.0.12",
		"@tarojs/plugin-framework-react": "4.0.12",
		"@tarojs/plugin-platform-alipay": "4.0.12",
		"@tarojs/plugin-platform-h5": "4.0.12",
		"@tarojs/plugin-platform-harmony-hybrid": "4.0.12",
		"@tarojs/plugin-platform-jd": "4.0.12",
		"@tarojs/plugin-platform-qq": "4.0.12",
		"@tarojs/plugin-platform-swan": "4.0.12",
		"@tarojs/plugin-platform-tt": "4.0.12",
		"@tarojs/plugin-platform-weapp": "4.0.12",
		"@tarojs/react": "4.0.12",
		"@tarojs/runtime": "4.0.12",
		"@tarojs/shared": "4.0.12",
		"@tarojs/taro": "4.0.12",
		"@xyfs/utils": "workspace:^",
		"async-validator": "^4.2.5",
		"date-fns": "^2.30.0",
		"just-throttle": "^4.2.0",
		"react": "^18.0.0",
		"react-dom": "^18.0.0",
		"tslib": "^2.6.3",
		"zustand": "^4.5.4"
	},
	"devDependencies": {
		"@babel/core": "^7.24.4",
		"@babel/plugin-proposal-class-properties": "7.14.5",
		"@babel/preset-react": "^7.24.1",
		"@tarojs/cli": "4.0.12",
		"@tarojs/vite-runner": "4.0.12",
		"@types/node": "^22.10.2",
		"@types/react": "^18.0.0",
		"@vitejs/plugin-react": "^4.3.0",
		"@vitejs/plugin-react-swc": "^3.7.0",
		"babel-preset-taro": "4.0.12",
		"eslint": "^8.57.0",
		"eslint-config-taro": "4.0.12",
		"eslint-plugin-react": "^7.34.1",
		"eslint-plugin-react-hooks": "^4.4.0",
		"postcss": "^8.4.38",
		"react-refresh": "^0.14.0",
		"stylelint": "^16.4.0",
		"terser": "^5.30.4",
		"typescript": "^5.4.5",
		"vite": "^4.2.0"
	}
}
